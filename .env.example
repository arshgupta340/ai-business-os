# Copy to .env.local and fill in. Never commit .env.local.
# Names are defined in docs/SPEC.md section 3.3. How to get each value: docs/SETUP-ACCOUNTS.md.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Owner connection: migrations and the reset script only.
DATABASE_ADMIN_URL=
# Restricted abos_app login for the running server.
DATABASE_URL=

# --- Web (apps/web). Only these three are needed by the UI developer. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
# Set to 1 to run the UI on fixtures with no backend.
NEXT_PUBLIC_MOCK=1

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BUILDER_MODEL=
OPENAI_REALTIME_MODEL=

# --- Square. Must be sandbox. The server refuses to start otherwise. ---
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# --- Twilio (voice) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Message channel: surge | android_gateway | whatsapp_sandbox | qr_only ---
MESSAGE_CHANNEL=qr_only
SURGE_API_KEY=
ANDROID_GATEWAY_URL=
ANDROID_GATEWAY_API_KEY=
TWILIO_WHATSAPP_FROM=

# --- Google (barbershop agent and Sheets mirror) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_ID=

# --- Server ---
PUBLIC_SERVER_URL=
PORT=4000
# The web app address allowed by CORS.
WEB_ORIGIN=http://localhost:3000
# Local development only. 1 treats any bearer token as the seeded owner. Refused when NODE_ENV=production.
BUILDER_DEV_AUTH=
