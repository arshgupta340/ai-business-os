# Copy to apps/web/.env.local for local values. Never commit .env.local.
# Names are defined in docs/SPEC.md section 3.3.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
# 1 runs the UI on fixtures with no backend and no Supabase.
NEXT_PUBLIC_MOCK=1
# 1 shows the scripted demo path on the Build screen (issue #152). Leave it 0 for the real builder.
NEXT_PUBLIC_DEMO_SCRIPT=0
# The phone number the demo result panel shows, in E.164 (for example +18055550199). Fixed before the demo.
NEXT_PUBLIC_DEMO_PHONE_NUMBER=
