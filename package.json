{
  "name": "ai-business-os",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "dev:server": "npm run dev -w @abos/server",
    "dev:web": "npm run dev -w apps/web",
    "board": "node scripts/board.mjs",
    "seed": "tsx scripts/seed.ts",
    "seed:square": "tsx scripts/seed.ts square",
    "seed:demo-shop": "tsx scripts/seed-demo-shop.ts",
    "seed:demo-stage": "tsx scripts/seed-demo-stage.ts",
    "reset": "tsx scripts/reset.ts",
    "check-env": "node scripts/check-env.mjs",
    "register-webhooks": "tsx scripts/register-webhooks.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
